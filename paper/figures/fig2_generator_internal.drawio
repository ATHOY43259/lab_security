<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="FALE-GAN Generator Internals" id="fig2gen">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="frameI" value="Frame I&#10;(3 ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="maskM" value="Face mask M&#10;(1 ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="brightb" value="Brightness b&#10;(1 ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="concat" value="Concat&#10;(5 ch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="190" y="120" width="90" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="frameI" target="concat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="maskM" target="concat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="brightb" target="concat"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Encoder chain (top row) -->
        <mxCell id="e1" value="e1&#10;Conv 5-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="e2&#10;Conv 32-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="120" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="e3&#10;Conv 32-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="e4&#10;Conv 32-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="120" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="concat" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decoder chain (bottom row) -->
        <mxCell id="d1" value="d1&#10;Conv 64-&gt;12, 3x3, tanh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="320" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="d2&#10;Conv 64-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="d3&#10;Conv 64-&gt;32, 3x3, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="320" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cd1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cd2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Skip connections -->
        <mxCell id="skip1" value="skip (concat)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#888888;fontColor=#888888;fontSize=9;" edge="1" parent="1" source="e1" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="skip2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="e2" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="skip3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="e3" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="skip4" value="bottleneck" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#888888;fontColor=#888888;fontSize=9;exitX=0.5;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="e4" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Attention gate, refinement, output -->
        <mxCell id="gate" value="Attention gate&#10;A' = A(1+alpha*M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="480" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="refine" value="Iterative refinement&#10;k=1..4:&#10;I_hat &lt;- I_hat + a_k(I_hat^2 - I_hat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="outI" value="Enhanced&#10;frame I'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="485" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cg1" value="curves A (12 ch)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;" edge="1" parent="1" source="d1" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cg2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gate" target="refine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cg3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="refine" target="outI"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cg4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="maskM" target="gate"><mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="230" y="530" /></Array>
          </mxGeometry></mxCell>
        <mxCell id="cg5" value="I_hat &lt;- I (initial value)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;fontColor=#888888;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="frameI" target="refine"><mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="0" y="600" /><mxPoint x="690" y="600" /></Array>
          </mxGeometry></mxCell>

        <mxCell id="caption" value="Fig. 2: Internal architecture of the FALE-GAN generator: an encoder-decoder with skip connections, conditioned on a face-attention mask M and a brightness estimate b, followed by attention-gated, iterative curve-based enhancement. Channel counts, layer order, and the curve update rule match the implementation exactly." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="1080" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
