<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="YOLOv8 Customization" id="fig3yolo">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lbl_stock" value="Stock&#10;(pretrained&#10;on COCO)" style="text;html=1;align=right;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stock_bb" value="YOLOv8n backbone + neck&#10;(CSPDarknet, C2f, SPPF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="130" y="50" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stock_head" value="Detect head&#10;80-class COCO output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="50" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_stock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="stock_bb" target="stock_head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lbl_ft" value="Fine-tuned&#10;(this work)" style="text;html=1;align=right;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ft_bb" value="YOLOv8n backbone + neck&#10;(same architecture, fine-tuned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="130" y="310" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ft_head" value="Detect head&#10;single-class &quot;face&quot; output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_ft" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ft_bb" target="ft_head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_transfer" value="weights transferred&#10;(319 / 355 tensors)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="stock_bb" target="ft_bb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_reinit" value="classification layers&#10;reinitialized (nc: 80 to 1)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#CC0000;fontColor=#CC0000;fontSize=10;" edge="1" parent="1" source="stock_head" target="ft_head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="data_box" value="DARK FACE: 45,474 face boxes&#10;5,400 train / 600 held-out images&#10;60 epochs (12+18+30), 320x320" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_databb" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ft_bb" target="data_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_datahead" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ft_head" target="data_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="result_box" value="Result (own validation split):&#10;Precision 0.528   Recall 0.235   mAP50 0.229&#10;(standard IoU-based protocol; see Table V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="200" y="570" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="data_box" target="result_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="Fig. 3: Face-detector customization. The backbone and neck retain their COCO-pretrained weights; only the Detect head's classification branch is reinitialized for the single &quot;face&quot; class, then the full network is fine-tuned end-to-end on DARK FACE." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="780" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
